# RetailMate RAG Service Configuration

# Service
RAG_HOST=0.0.0.0
RAG_PORT=8001

# Backend Integration
BACKEND_URL=http://localhost:8002

# ChromaDB
CHROMA_PERSIST_DIRECTORY=./data/chroma

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
TOP_K=5

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=75
